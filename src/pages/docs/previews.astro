---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { imagePreviewSupport, previewCoverage } from "../../data/docs.js";
---

<DocsLayout
  title="elio docs: previews"
  description="Preview coverage, inline image support, terminal multiplexers, and SSH behavior in elio."
  currentPath="/docs/previews/"
  heading="Previews"
  lead="Preview coverage, image support, terminal multiplexers, and SSH behavior."
>
  <section class="docs-section docs-section-first">
    <div class="docs-section-heading">
      <p class="eyebrow">COVERAGE</p>
      <h2 class="docs-section-title">What elio can preview</h2>
    </div>

    <article class="doc-card docs-detail-card">
      <table class="docs-table docs-preview-coverage-table">
        <colgroup>
          <col class="docs-preview-type" />
          <col class="docs-preview-support" />
        </colgroup>
        <thead>
          <tr>
            <th scope="col">Type</th>
            <th scope="col">Preview support</th>
          </tr>
        </thead>
        <tbody>
          {previewCoverage.map((item) => (
            <tr>
              <th scope="row" data-label="Type">{item.title}</th>
              <td data-label="Preview support">{item.body}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </article>

    <article class="doc-card docs-callout-card">
      <h3>Optional preview tools</h3>
      <p>Install preview tools for rendered PDFs, video thumbnails, album art, SVGs, comic archives, and extra archive formats.</p>
      <a class="docs-link" href="/docs/optional-tools/">View optional tools</a>
    </article>
  </section>

  <section class="docs-section">
    <div class="docs-section-heading">
      <p class="eyebrow">IMAGE PREVIEWS</p>
      <h2 class="docs-section-title">Image Preview Compatibility</h2>
    </div>

    <div class="docs-preview-grid">
      <article class="doc-card docs-card-tight docs-detail-card docs-support-card">
        <h3>Terminal support</h3>
        <div class="docs-support-scroller">
          <table class="docs-table docs-support-table">
            <thead>
              <tr>
                <th scope="col">Terminal</th>
                <th scope="col">Protocol</th>
                <th scope="col">Status</th>
              </tr>
            </thead>
            <tbody>
              {imagePreviewSupport.map((entry) => (
                <tr>
                  <th scope="row">{entry.terminal}</th>
                  <td>{entry.protocol}</td>
                  <td><span class={`docs-support-status docs-support-status--${entry.tone}`}>{entry.status}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </article>

      <article class="doc-card docs-card-tight docs-preview-summary">
        <h3>Notes</h3>
        <ul class="docs-list">
          <li><span>For other terminals that support the Kitty Graphics Protocol, set <code>ELIO_IMAGE_PREVIEWS=1</code> to enable image previews.</span></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="docs-section">
    <div class="docs-section-heading">
      <p class="eyebrow">TERMINAL MULTIPLEXERS</p>
      <h2 class="docs-section-title">Using elio inside tmux or Zellij</h2>
    </div>

    <div class="docs-two-up docs-align-start">
      <article class="doc-card docs-card-tight docs-preview-summary">
        <h3>tmux</h3>
        <p>Image previews work in all supported terminals. elio configures passthrough automatically for the current pane.</p>
      </article>

      <article class="doc-card docs-card-tight docs-preview-summary">
        <h3>Zellij</h3>
        <p>In Zellij 0.45+, image previews work with Kitty, Ghostty, Rio, Warp, Konsole, WezTerm, foot, and Windows Terminal.</p>
      </article>
    </div>
  </section>

  <section class="docs-section">
    <div class="docs-section-heading">
      <p class="eyebrow">SSH</p>
      <h2 class="docs-section-title">Using elio over SSH</h2>
    </div>

    <article class="doc-card docs-callout-card">
      <h3>Remote preview behavior</h3>
      <p>Text and code previews work well over SSH. Rich visual previews depend on image protocol support in the local terminal and optional preview tools on the remote host. Terminal apps chosen through Open With run inside the current SSH session, while GUI/default openers use the remote host opener stack.</p>
    </article>
  </section>

</DocsLayout>
