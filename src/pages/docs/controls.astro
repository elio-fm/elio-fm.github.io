---
import DocsLayout from "../../layouts/DocsLayout.astro";

const controlColumns = [
  [
    {
      title: "Navigation",
      rows: [
        [["k / ↑"], "Move focus up."],
        [["j / ↓"], "Move focus down."],
        [["h / ← / Backspace"], "Go to the parent folder."],
        [["l / →"], "Enter the focused folder."],
        [["Enter"], "Enter a folder, or open a file or selection."],
        [["g"], "Open the Go-to menu."],
        [["/"], "Filter the current folder."],
        [["Home"], "Jump to the first item."],
        [["G / End"], "Jump to the last item."],
        [["PgUp / PgDn"], "Move one page up or down."],
        [["Tab / Shift+Tab"], "Cycle through Places."],
        [["Alt+← / Alt+→"], "Go back or forward in folder history."],
      ],
    },
    {
      title: "Mouse",
      rows: [
        [["Click"], "Focus an item."],
        [["Double-click"], "Open a file or enter a folder."],
        [["Scroll"], "Move through files or scroll the preview."],
        [["Shift+Scroll"], "Scroll the preview sideways."],
      ],
    },
    {
      title: "Selection & Clipboard",
      rows: [
        [["Space"], "Add or remove the focused item from the selection."],
        [["Ctrl+A"], "Select everything in the current folder."],
        [["Esc"], "Clear the selection."],
        [["y"], "Yank (copy)."],
        [["c"], "Copy path details to the clipboard."],
        [["x"], "Cut."],
        [["p"], "Paste."],
        [["-"], "Create absolute symlinks."],
        [["_"], "Create relative symlinks."],
      ],
    },
  ],
  [
    {
      title: "Search",
      rows: [
        [["z"], "Jump using zoxide history."],
        [["f"], "Fuzzy-find folders in the current tree."],
        [["Ctrl+F"], "Fuzzy-find files in the current tree."],
      ],
    },
    {
      title: "File Actions",
      rows: [
        [["a"], "Create files or folders."],
        [["d / Del"], "Move items to Trash; delete permanently when already in Trash."],
        [["D / Shift+Del"], "Delete permanently."],
        [["r / F2"], "Rename, or bulk rename selected items."],
        [["R / Shift+F2"], "Rename in your editor."],
        [["r"], "Restore from Trash when viewing Trash."],
        [["e"], "Extract the focused archive."],
        [["C"], "Create an archive."],
        [["!"], "Open your shell in the current folder."],
        [["o"], "Open with the default app."],
        [["O"], "Choose an app with Open With."],
      ],
    },
    {
      title: "Preview",
      rows: [
        [["K / ["], "Go to the previous page or scroll the preview up."],
        [["J / ]"], "Go to the next page or scroll the preview down."],
        [["H / L"], "Scroll the preview left or right."],
      ],
    },
    {
      title: "View",
      rows: [
        [["v"], "Switch between grid and list view."],
        [["Ctrl++ / Ctrl+-"], "Zoom the grid in or out."],
        [["."], "Show or hide dotfiles."],
        [["s"], "Cycle the sort order."],
        [["?"], "Open the live help overlay."],
        [["q"], "Quit."],
        [["Q"], "Quit without changing the parent shell directory."],
      ],
    },
  ],
];

---

<DocsLayout
  title="elio docs: default controls"
  description="Useful elio keyboard and mouse controls, plus the in-app help overlay."
  currentPath="/docs/controls/"
  heading="Default controls"
>
  <section class="docs-section docs-section-first">
    <div class="docs-section-heading">
      <p class="eyebrow">LIVE BINDINGS</p>
      <h2 class="docs-section-title">Current bindings</h2>
    </div>

    <div class="docs-two-up docs-align-start">
      <article class="doc-card docs-detail-card">
        <ul class="docs-list docs-inline-key-list">
          <li><code>?</code><span>See current bindings, including your overrides.</span></li>
        </ul>
      </article>

      <article class="doc-card docs-detail-card">
        <ul class="docs-list docs-inline-key-list">
          <li><code>Esc</code><span>Closes overlays, cancels prompts, or clears selection.</span></li>
        </ul>
      </article>
    </div>
  </section>

  <section class="docs-section">
    <div class="docs-section-heading">
      <p class="eyebrow">KEYBOARD</p>
      <h2 class="docs-section-title">Default controls</h2>
    </div>

    <div class="docs-two-up docs-align-start">
      {controlColumns.map((column) => (
        <div class="docs-detail-stack">
          {column.map(({ title, rows }) => (
            <article class="doc-card docs-card-tight">
              <h3>{title}</h3>
              <table class="docs-table docs-table-compact docs-control-card-table" aria-label={`${title} controls`}>
                <tbody>
                  {rows.map(([keys, body]) => (
                    <tr>
                      <th scope="row">
                        <span class="docs-key-sequence">
                          {keys.map((key) => <code>{key}</code>)}
                        </span>
                      </th>
                      <td>{body}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </article>
          ))}
        </div>
      ))}
    </div>
  </section>

</DocsLayout>
